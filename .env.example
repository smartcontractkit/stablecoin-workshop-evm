# ==============================================================================
# CHAINLINK ORACLE-BACKED CROSS-CHAIN STABLECOIN WORKSHOP
# EVM → EVM Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# STEP 1: Choose Your Chain Pair
# ------------------------------------------------------------------------------
# Select any 2 chains from the pre-supported networks.
# Use the exact names from hardhat.config.ts (with hyphens):
#
# Pre-Supported Networks:
#   - arbitrum-sepolia   (Arbitrum Sepolia Testnet)
#   - avalanche-fuji     (Avalanche Fuji Testnet)
#   - base-sepolia       (Base Sepolia Testnet - add to hardhat.config.ts)
#   - sepolia            (Ethereum Sepolia - add to hardhat.config.ts)
#   - polygon-amoy       (Polygon Amoy - add to hardhat.config.ts)

CHAIN_FROM=arbitrum-sepolia
CHAIN_TO=avalanche-fuji

# ------------------------------------------------------------------------------
# STEP 2: Private Key
# ------------------------------------------------------------------------------
# Your wallet private key (do NOT share or commit this to git!)
PRIVATE_KEY=

# ------------------------------------------------------------------------------
# STEP 3: Deployment Addresses (Auto-filled During Workshop)
# ------------------------------------------------------------------------------
# FROM Chain = Source (where transfers originate)
ORACLE_CONTRACT_ADDRESS_FROM=
STABLECOIN_CONTRACT_ADDRESS_FROM=
TOKEN_POOL_ADDRESS_FROM=

# TO Chain = Destination (where transfers arrive)
ORACLE_CONTRACT_ADDRESS_TO=
STABLECOIN_CONTRACT_ADDRESS_TO=
TOKEN_POOL_ADDRESS_TO=

# ==============================================================================
# OPTIONAL CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# Custom RPC URLs
# ------------------------------------------------------------------------------
# By default, hardhat.config.ts uses public RPC endpoints for each network.
# You can override these by uncommenting and setting custom URLs below
# (e.g., using Alchemy, Infura, or other providers for better performance).

# ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# AVALANCHE_FUJI_RPC_URL=https://avalanche-fuji-c-chain-rpc.publicnode.com
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# SEPOLIA_RPC_URL=https://rpc.sepolia.org
# POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# ------------------------------------------------------------------------------
# Block Explorer API Keys
# ------------------------------------------------------------------------------
# ARBISCAN_API_KEY=
# SNOWTRACE_API_KEY=
